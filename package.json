{
  "name": "recupere",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "benchmark:check": "npm run benchmark:validate && npm run benchmark:results",
    "benchmark:results": "node scripts/benchmark-results.mjs",
    "benchmark:template": "node scripts/benchmark-manifest.mjs --template benchmarks/results/template-v1.json",
    "benchmark:validate": "node scripts/benchmark-manifest.mjs",
    "benchmark:report": "node scripts/benchmark-report.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome check src e2e",
    "lint:fix": "biome check --write src e2e",
    "format": "biome format --write src e2e",
    "format:check": "biome format src e2e",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -W warnings",
    "bench": "cargo bench --manifest-path src-tauri/Cargo.toml",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:preflight:bundle": "node scripts/release-preflight.mjs --require-license-pubkey",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:updater-keygen": "node scripts/generate-updater-key.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:build": "npm run release:preflight:bundle && npm run tauri build",
    "release:build-and-verify": "npm run release:build && npm run release:verify",
    "test": "npm run test:ui && npm run test:rust",
    "test:e2e": "playwright test",
    "test:e2e:native": "node scripts/run-native-e2e.mjs",
    "test:e2e:native:linux": "wdio run wdio.tauri-driver.conf.ts",
    "test:e2e:native:windows": "wdio run wdio.tauri-driver.conf.ts",
    "test:e2e:native:macos": "wdio run wdio.appium.conf.ts",
    "test:ui": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^26.0.2",
    "lucide-react": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.1",
    "react-router-dom": "^7.13.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.54.2",
    "@tauri-apps/cli": "^2",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "@wdio/types": "^9.27.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.2",
    "webdriverio": "^9.27.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
